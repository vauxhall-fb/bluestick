{
_bluerps = RAND(2)

case _bluerps
      {
             when 0
            {
                if tesstvar == "rpsrock"
                {
                "\0\s[0]%(i)blue chooses paper.%(clrmrk)\w8\w8\n\n\s[5]aw yeah, i win!\w8 paper beats rock!\w8\w8\s[0] another round?\n\n\_q\q[sure,igrps]\n\q[nah,OnIntGames]"
                }
                elseif tesstvar == "rpspaper"
                {
                "\0\s[0]%(i)blue chooses paper.%(clrmrk)\w8\w8\n\n\s[1]damn, a tie...\w8\w8 \s[0]another round?\n\n\_q\q[sure,igrps]\n\q[nah,OnIntGames]"
                }
                elseif tesstvar == "rpsscissors"
                {
                "\0\s[0]%(i)blue chooses paper.%(clrmrk)\w8\w8\n\n\s[4]aw man, i lost....\w8 welp...\w8\w8\s[0] another round?\n\n\_q\q[sure,igrps]\n\q[nah,OnIntGames]"
                }
                else
                {
                "\0\s[0]if you're seeing this, this is an error.\e"
                }
            }
            when 1
            {
                if tesstvar == "rpspaper"
                {
                "\0\s[0]%(i)blue chooses scissors.%(clrmrk)\w8\w8\n\n\s[5]aw yeah, i win!\w8 scissors beats paper!\w8\w8\s[0] another round?\n\n\_q\q[sure,igrps]\n\q[nah,OnIntGames]"
                }
                elseif tesstvar == "rpsscissors"
                {
                "\0\s[0]%(i)blue chooses scissors.%(clrmrk)\w8\w8\n\n\s[1]damn, a tie...\w8\w8\s[0] another round?\n\n\_q\q[sure,igrps]\n\q[nah,OnIntGames]"
                }
                elseif tesstvar == "rpsrock"
                {
                "\0\s[0]%(i)blue chooses scissors.%(clrmrk)\w8\w8\n\n\s[4]aw man, i lost....\w8 welp...\w8\w8\s[0] another round?\n\n\_q\q[sure,igrps]\n\q[nah,OnIntGames]"
                }
                else
                {
                "\0\s[0]if you're seeing this, this is an error.\e"
                }
            }
            when 2
            {
                if tesstvar == "rpsscissors"
                {
                "\0\s[0]%(i)blue chooses rock.%(clrmrk)\w8\w8\n\n\s[5]aw yeah, i win!\w8 rock beats scissors!\w8\w8\s[0] another round?\n\n\_q\q[sure,igrps]\n\q[nah,OnIntGames]"
                }
                elseif tesstvar == "rpsrock"
                {
                "\0\s[0]%(i)blue chooses rock.%(clrmrk)\w8\w8\n\n\s[1]damn, a tie...\w8\w8\s[0] another round?\n\n\_q\q[sure,igrps]\n\q[nah,OnIntGames]"
                }
                elseif tesstvar == "rpspaper"
                {
                "\0\s[0]%(i)blue chooses rock.%(clrmrk)\w8\w8\n\n\s[4]aw man, i lost....\w8 welp...\w8\w8\s[0] another round?\n\n\_q\q[sure,igrps]\n\q[nah,OnIntGames]"
