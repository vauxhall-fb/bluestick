//--- made this to not absolutely clutter aitalk lol ---

OnIntChatter
{
    //emotions list so i dont have to keep checking the shell folder
    //0 - default
    //1 - shrug
    //2 - surprise
    //3 - blush
    //4 - defeated/sad/other negative emotion
    //5 - excited
    //6 - thumbs up
    //7 - angry
    //8 - think
    //9 - bleeeehhhhh
    //110 - sitting
    //111 - reading
    //112 "so i was playing on my switch-" nintendopilled switchmaxxing
    
    //"\0\s[0]test!\e" YAY IT WORKS!!! TADA EMOJI
    
    "\0\s[0]ohh, yeah? wanna talk?\_q\n\n\![*]\q[ask Bluestick something,askblue]"
    --
    if hangingOut == "false"
    {
    "\n\![*]\q[hang out with me,OnHangout]"
    }
    --
    "\n\n\![*]\q[Nevermind,BACKTOMENU]"
    
    //. paste after the second \n . \![*]ask me something (bugged out right now)\n
    
}

