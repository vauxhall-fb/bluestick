// ----- rock paper scissors -----

Select.igrps
    {
    "\s[0]aw yeah, rock paper scissors!\w8 i'm ready when you are!\w8\w8\n\n\_q\![*]\q[rock,rpsrock]\n\![*]\q[paper,rpspaper]\n\![*]\q[scissors,rpsscissors]"
    }
    
Select.rpsrock
    {
    tesstvar = reference0
    "\0\s[0]%(i)you choose rock...%(clrmrk)\w8\w8\n\n\![raise,OnRpsCheck]"
    }
    
Select.rpspaper
    {
    tesstvar = reference0
    "\0\s[0]%(i)you choose paper...%(clrmrk)\w8\w8\n\n\![raise,OnRpsCheck]"
    }
    
Select.rpsscissors
    {
    tesstvar = reference0
    "\0\s[0]%(i)you choose scissors...%(clrmrk)\w8\w8\n\n\![raise,OnRpsCheck]"
    }
    
// ----------- hangout

OnHangout
{
    "\0\s[5]\b[2]what do you wanna do?\n\n\_q\![*]\q[play something,hangoutplay]\n\![*]\q[watch something,hangoutwatch]\n\![*]\q[draw,hangoutdraw]\n\![*]\q[listen to something,hangoutlisten]\n\![*]\q[make music,hangoutmusic]\n\![*]\q[read,hangoutread]\n\![*]\q[just hangout,hangoutokay]\n\![*]\q[nevermind,OnIntChatter]"
}

Select.hangoutplay
{
    hangouttype = "play"
    "\0\s[5]sure! i'll play something alongside you, if thats cool!\w8\w8\w8\w8\w8\cdo you want me to stop talking while we hang?\n\n\_q\q[sure,shutupblue]\n\q[nah,OnHangoutTalk]"
}

