{
    hangouttype = "watch"
    "\0\s[5]sure! i cant wait to see what you got in mind!\w8\w8\w8\w8\w8\cdo you want me to stop talking while we hang?\n\n\_q\q[sure,shutupblue]\n\q[nah,OnHangoutTalk]"
}

