 Select.caRed
    {
    "\0\s[0]oooh, red huh?\w5 red is a pretty cool color, honestly.\e"
    }
    
Select.othercolor
    {
    "\q[Indigo,caIndigo]\n\q[Purple,caPurple]\n\q[Violet,caViolet]\n\q[Pink,caPink]\n\q[Magenta,caMagenta]\n\q[White,caWhite]\n\q[Grey,caGrey]\n\q[Black,caBlack]\n\q[All colors....,caRainbow]"
    }

//---- games ----

OnIntGames
{
    //"\0\s[0]test!\e" works!!
    
    "\0\s[5]wanna play a game?\_q\n\n\![*]\q[rock paper scissors,igrps]\n\![*]\q[trivia,igtrivia]\n\n\![*]\q[Nevermind,BACKTOMENU]"
}

// ----- trivia -----

Select.igtrivia
    {
    "\0\s[0]oooh, trivia eh?\w8 pick a category!\_q\n\n\![*]\q[Easy trivia,OnGameTriviaEasy]\n\![*]\q[Meme trivia,OnGameTriviaMeme]\n\![*]\q[...nevermind,OnIntGames]"
    
    //. insert after \n on memetrivia when finished  . \![*]Periodic table trivia (not finished yet)\n\![*]Fandom trivia (not finished yet)\n
    }

OnGameTriviaEasy
{
triviatype = 1
_temprivia = RAND(10)

case _temprivia
    {
        when 0
        {
        anser = "52"
        altAnser = "fifty two"
        respondAnser = "there are 52 cards in a typical deck."
        "\0\s[0]how many cards are in a typical deck of playing cards?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 1
        {
        anser = "the mitochondria"
        altAnser = "mitochondria"
        respondAnser = "the mitochondria is the powerhouse of the cell."
        "\0\s[0]what is the powerhouse of the cell?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 2
        {
        anser = "the nile"
        altAnser = "nile river"
        respondAnser = "the nile river is the longest river in the world."
        "\0\s[0]what is the longest river in the world?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 3
        {
        anser = "world wide web"
        altAnser = "the world wide web"
        respondAnser = "WWW stands for world wide web."
        "\0\s[0]what does WWW mean?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 4
        {
        anser = "k"
        respondAnser = "the symbol on the periodic table for potassium is K."
        "\0\s[0]what is the chemical symbol used to represent the element potassium on the periodic table?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 5
        {
        anser = "jupiter"
        respondAnser = "the largest planet in the solar system is jupiter."
        "\0\s[0]what is the largest planet in the solar system?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 6
        {
        anser = "strike"
        altAnser = "a strike"
        respondAnser = "when a batter misses the ball in baseball, it is called a strike."
        "\0\s[0]when playing baseball, what is it called when the batter misses and does not hit the ball?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 7
        {
        anser = "mercury"
        respondAnser = "the planet closest to the sun is mercury."
        "\0\s[0]what is the planet closest to the sun?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 8
        {
        anser = "black widow"
        altAnser = "widow"
        respondAnser = "the spider known for the red hourglass marking on it's back is the black widow."
        "\0\s[0]which spider is known for it's distinctive red hourglass marking?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 9
        {
        anser = "laughing out loud"
        respondAnser = "the acronym LOL stands for laughing out loud, but some people, usually older people, may use it differently, such as to mean lots of laughs or lots of love."
        "\0\s[0]what does LOL mean?\![open,inputbox,OnTriviaAnswer,-1]"
        }
    }
}

OnGameTriviaMeme
{
triviatype = 2
_temprivia = RAND(8)

case _temprivia
    {
        when 0
        {
        anser = "rick astley"
        respondAnser = "the song ''never gonna give you up'' is by rick astley."
        "\0\s[0]who made the infamous song ''never gonna give you up''?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 1
        {
        anser = "pepe"
        altAnser = "pepe the frog"
        respondAnser = "the frog is known as pepe the frog."
        "\0\s[0]what is the name of the green frog often used in memes and as a twitch emote?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 2
        {
        anser = "mcdonalds"
        respondAnser = "the first thing any female born after 1983 knows is McDonalds."
        "\0\s[0]what is the first thing any female born after 1983 knows?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 3
        {
        anser = "financial support"
        altAnser = "your financial support"
        respondAnser = "bernie sanders is once again asking for your financial support."
        "\0\s[0]what is bernie sanders asking for?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 4
        {
        anser = "loss"
        respondAnser = "im at a loss for words"
        "\0\s[0]l   ll\nll   l_\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 5
        {
        anser = "kabosu"
        respondAnser = "doge's real name is kabosu."
        "\0\s[0]what is the name of doge?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 6
        {
        anser = "haha 69"
        altAnser = "420"
        respondAnser = "hell yeah."
        "\0\s[0]69?\![open,inputbox,OnTriviaAnswer,-1]"
        }
        when 7
        {
        anser = "us"
        altAnser = "you"
        respondAnser = "all your base are belong to us."
        "\0\s[0]who does your base belong to?\![open,inputbox,OnTriviaAnswer,-1]"
        }
    }
}

OnTriviaAnswer
{
userAnser = reference0

if userAnser == anser || userAnser == altAnser
      {
      "\0\s[5]correct!\w5 %(respondAnser)\w8\x\c\s[0]play again?\n\n\_q\![*]\q[yes,triviaplayagain]\n\![*]\q[no,OnIntGames]"
      }
else
      {
      "\0\s[9]er!\w5 incorrect.\w8\s[0] the correct answer is %(anser)\n\n\w8\x\c\s[0]play again?\n\n\_q\![*]\q[yes,triviaplayagain]\n\![*]\q[no,triviaexit]"
      }
}

Select.triviaplayagain
{
    if triviatype == 1
    {
    "\0\s[0]same category or a different one?\n\n\![*]\q[same one,OnGameTriviaEasy]\n\![*]\q[different one,igtrivia]"
    }
    elseif triviatype == 2
    {
    "\0\s[0]same category or a different one?\n\n\![*]\q[same one,OnGameTriviaMeme]\n\![*]\q[different one,igtrivia]"
    }
    else
    {
    "\0\s[0]if you're seeing this, this is an error.\e"
    }
}

