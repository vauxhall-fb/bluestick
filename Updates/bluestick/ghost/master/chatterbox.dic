//--- selects ---

Select.askme
    {
    "\0\s[0]ooh, you want me to ask something about you...???\w5\s[1] lemme think of a question real quick...\w8\s[8]\w8\w8\w8\w8\w5\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8\w8 %(blueaskme)\c"
    }
    
Select.askblue
    {
    "\0\s[0]what do you wanna ask?\_q\n\n\![*]\q[how are you doing?,abHowDoing]\n\![*]\q[ask about his friends,abFriends]\n\![*]\q[ask about his job,abJob]\n\![*]\q[ask about his hobbies,abHobbies]\n\![*]\q[ask about his family,abFamily]\n\![*]\q[ask about his love life,abLove]\n"
    }
    
//------ selects for the askblue section -----

Select.abHowDoing
    {
    "\0\s[0]glad you asked! i'm "
    --
    "feelin good"
    "great"
    "okay"
    "kinda meh"
    "chillin"
    "tired"
    "in the mood for some food"
    "vibrating with barely restrained positive energy and emotion"
    --
    " right now.\w8 what about you?\n\n\_q\![*]\q[i'm great,hdGreat]\n\![*]\q[i'm good,hdGood]\n\![*]\q[i'm okay,hdOk]\n\![*]\q[i'm meh,hdMeh]\n\![*]\q[i'm not too good,hdFrownEmoji]\n\![*]\q[i'm bad,hdBad]\n"
    }
    
Select.abFriends
    {
    "\0\s[0]my friends?\w5\w5\s[5] oh, yeah, i got a loooooooooot of friends!\w5 they're all really chill, too.\x\s[3]....dont tell anyone,\w5 but %(txtred)%(i)Red%(clrmrk) is my favorite.\w8\n\n\_q\![*]\q[ask something else,askblue]\n\![*]\q[menu,BACKTOMENU]"
    }

Select.abJob
    {
    "\0\s[1]my......job????\w8\w8\w8\s[4] i dont really have one.... unless you call playing games all day without an audience a job..\w8\n\n\_q\![*]\q[ask something else,askblue]\n\![*]\q[menu,BACKTOMENU]"
    }
    
Select.abHobbies
    {
    "\0\s[8]hobbies, huh...\w8\w8\w8\s[0] i guess i like gaming...does that count?\w8\n\n\_q\![*]\q[ask something else,askblue]\n\![*]\q[menu,BACKTOMENU]"
    }
    
Select.abFamily
    {
    "\0\s[0]my family?\w8\s[5]oh yeah!\w5 i got a little sibling, %(i)DB!%(clrmrk)! that's basically it, though.\w8\n\n\_q\![*]\q[ask something else,askblue]\n\![*]\q[menu,BACKTOMENU]"
    }
    
Select.abLove
    {
    "\0\s[1]..............\w8\w8\w8\w8\c\s[4].......i don't wanna talk about it.\w8\n\n\_q\![*]\q[ask something else,askblue]\n\![*]\q[menu,BACKTOMENU]"
    "\0\s[1].....................\w8\w8\w8\w8\c\s[4]yeah, no.\w8\n\n\_q\![*]\q[ask something else,askblue]\n\![*]\q[menu,BACKTOMENU]"
    }
    
//-------- subselect for the how doing --------

Select.hdGreat
    {
    "\0\s[6]hell yeah! good to hear!\e"
    }

Select.hdGood
    {
    "\0\s[6]good to hear!\e"
    }
    
Select.hdOk
    {
    "\0\s[0]cool.\e"
    }
    
Select.hdMeh
    {
    "\0\s[1]ah, yeah.\w5 know the feeling.\e"
    }
    
Select.hdFrownEmoji
    {
    "\0\s[1]oh, damn...\w5 that sucks...\w8 hope your day gets better.\e"
    }

Select.hdBad
    {
    "\0\s[1]oooh, yikes....\w8 hope things get better for you.\e"
    }
    
//------ selects for the others ------

    
